# ═══════════════════════════════════════════════════════
# Sales Management System - Environment Configuration
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ── App ──
APP_NAME=Sales Management System
APP_VERSION=2.0.0
ENVIRONMENT=production
DEBUG=false

# ── Database (Railway provides DATABASE_URL automatically) ──
# For local: postgresql://user:pass@localhost:5432/sales_mgmt
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_mgmt
DATABASE_ECHO=false

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Security ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS (comma-separated) ──
CORS_ORIGINS=*

# ── Rate Limiting ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ── Upload ──
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.xlsx,.xls,.csv

# ── Logging ──
LOG_LEVEL=INFO
LOG_FORMAT=json
